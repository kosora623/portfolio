---
import { footerSocialLinks, site } from '@/data/site';
import SocialIcon from '@/components/icons/SocialIcon.astro';
---

<footer class="page site-footer">
  <p class="mono">© 2026 {site.shortName}</p>
  <ul>
    {
      footerSocialLinks.map(link => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${link.name}（新しいタブで開きます）`}>
            <SocialIcon name={link.icon} />
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 64px 32px;
    color: var(--color-muted);
    font-size: 13px;
  }
  ul {
    display: flex;
    gap: 18px;
  }
  a {
    display: inline-flex;
    padding: 4px;
  }
  a:hover :global(svg) {
    color: var(--color-ink);
  }
</style>
