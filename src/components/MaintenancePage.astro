---
import { site } from '@/data/site';
---

<main class="page maintenance">
  <div class="sky" aria-hidden="true"></div>
  <h1 class="mono">{site.shortName}</h1>
  <p>ただいまサイトを改修しています。<br />しばらくお待ちください。</p>
  <p class="contact">ご連絡は <a href={`mailto:${site.contactEmail}`} class="link">{site.contactEmail}</a> まで。</p>
</main>

<style>
  .maintenance {
    max-width: 560px;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }
  .sky {
    height: 96px;
    background: linear-gradient(var(--sky-top), var(--sky-bottom));
  }
  h1 {
    font-size: 1.6rem;
    font-weight: 400;
    margin-top: 12px;
  }
  .contact {
    color: var(--color-muted);
    font-size: 14px;
  }
</style>
