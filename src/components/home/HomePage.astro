---
import SkyBand from './SkyBand.astro';
import LineIcon from '@/components/icons/LineIcon.astro';
import SocialIcon from '@/components/icons/SocialIcon.astro';
import { socialLinks } from '@/data/site';
import { hero, about, stack, interests, hobbies } from '@/data/profile';

interface Props {
  /** 作品の件数（「つくったものを見る」に表示） */
  worksCount: number;
}

const { worksCount } = Astro.props;
---

<SkyBand />

<section class="hero">
  <h1 class="mono">{hero.name}</h1>
  <p>{hero.tagline}</p>
  <a class="button" href="/works">つくったものを見る（{worksCount}）</a>
</section>

<div class="rows">
  {
    about.intro && (
      <section aria-labelledby="about">
        <h2 id="about" class="label">about</h2>
        <p>{about.intro}</p>
      </section>
    )
  }

  <section aria-labelledby="stack">
    <h2 id="stack" class="label">stack</h2>
    <dl class="stack">
      {
        stack.map(group => (
          <div>
            <dt>
              <LineIcon name={group.icon} />
              {group.label}
            </dt>
            <dd>{group.items.join('、')}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="interests">
    <h2 id="interests" class="label">interests</h2>
    <ul class="interests">
      {
        interests.map(item => (
          <li>
            <LineIcon name={item.icon} />
            {item.title}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="hobbies">
    <h2 id="hobbies" class="label">hobbies</h2>
    <ul class="hobbies">
      {
        hobbies.map(item => (
          <li>
            <b>
              <LineIcon name={item.icon} />
              {item.title}
            </b>
            {item.description && <span>{item.description}</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="contact">
    <h2 id="contact" class="label">contact</h2>
    <ul class="contact">
      {
        socialLinks.map(link => {
          const external = link.href.startsWith('http');
          return (
            <li>
              <a href={link.href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <b>
                  <SocialIcon name={link.icon} />
                  {link.name}
                </b>
                <span class="handle">{link.handle}</span>
                {external && (
                  <span class="ext">
                    <LineIcon name="external" />
                    <span class="sr-only-focusable">（新しいタブで開きます）</span>
                  </span>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</div>

<style>
  .hero {
    padding-block: 44px 56px;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 8vw, 5rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  .hero p {
    margin-top: 14px;
    font-size: 1.05rem;
  }
  .hero .button {
    margin-top: 32px;
  }

  .rows > section {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 8px 32px;
    border-top: 1px solid var(--color-line);
    padding-block: 30px;
    font-size: 1.06rem;
  }
  .rows > section:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .stack div {
    display: grid;
    grid-template-columns: 6.5em minmax(0, 1fr);
    gap: 16px;
  }
  .stack dt,
  .interests li,
  .hobbies b,
  .contact b {
    display: flex;
    align-items: center;
    gap: 0.55em;
  }
  .stack dt {
    color: var(--color-muted);
    align-items: flex-start;
    padding-top: 0.45em;
    line-height: 1.2;
  }
  .stack dd {
    min-width: 0;
  }

  .interests {
    columns: 2;
    column-gap: 36px;
  }
  .interests li {
    break-inside: avoid;
    border-bottom: 1px solid var(--color-line);
    padding-block: 5px;
  }

  .hobbies li + li {
    margin-top: 10px;
  }
  .hobbies b {
    font-weight: 500;
  }
  .hobbies span {
    display: block;
    padding-left: 1.7em;
    color: var(--color-muted);
    font-size: 14.5px;
    line-height: 1.7;
  }

  .contact a {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    padding-block: 9px;
    line-height: 1.7;
  }
  .contact li:first-child a {
    padding-top: 0;
  }
  .contact b {
    font-weight: 500;
  }
  .handle {
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .contact a:hover,
  .contact a:hover .handle,
  .contact a:hover :global(svg) {
    color: var(--color-link);
  }

  @media (max-width: 760px) {
    .rows > section {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 520px) {
    .interests {
      columns: 1;
    }
    .contact a {
      grid-template-columns: 7.5em minmax(0, 1fr) auto;
    }
  }
</style>
