---
/**
 * 作品一覧。年ごとにまとめ、サムネイルのカードを PC 4 列・スマホ 2 列で並べる（作品が増えても形が変わらない）。
 * 分野の絞り込みは JS が動くときだけ表示する（JS がなければ全件が見える）。
 */
import type { WorkFromMd } from '@/lib/work-model';
import { tagInfo } from '@/data/tags';
import LineIcon from '@/components/icons/LineIcon.astro';
import { formatYearMonth, groupByYear } from '@/lib/work-model';
import { listThumbnailSrc } from '@/lib/thumbnail';

interface Props {
  works: WorkFromMd[];
}

const { works } = Astro.props;
const years = groupByYear(works);
const filters = [
  { key: 'all', name: 'すべて', count: works.length },
  ...Object.entries(tagInfo).map(([key, t]) => ({ key, name: t.name, count: works.filter(w => w.tags.includes(key)).length })),
];
---

<div class="head">
  <h1>Works</h1>
  <span class="mono count" data-works-count>{works.length} 点</span>
  <fieldset class="filters" data-works-filter hidden>
    <legend class="sr-only-focusable">分野で絞り込む</legend>
    {
      filters.map(f => (
        <label>
          <input type="radio" name="works-filter" value={f.key} checked={f.key === 'all'} />
          <span>
            {f.name} <span class="mono">{f.count}</span>
          </span>
        </label>
      ))
    }
  </fieldset>
</div>

{
  years.map(({ year, works: list }) => (
    <section class="year" aria-labelledby={`y${year}`} data-year>
      <h2 id={`y${year}`} class="mono">
        {year}
        <small data-year-count>{list.length} 点</small>
      </h2>
      <ul class="grid">
        {list.map(work => (
          <li data-tags={work.tags.join(' ')}>
            <a href={`/works/${work.slug}`} class="card">
              <span class="thumb">
                {work.thumbnailUrl && <img src={listThumbnailSrc(work.thumbnailUrl)} alt="" loading="lazy" decoding="async" width="384" height="216" />}
              </span>
              <b>{work.title}</b>
              <span class="meta">
                <span class="mono">{formatYearMonth(work)}</span>
                {work.tags.map(t => tagInfo[t] && (
                  <span class="tag">
                    <LineIcon name={tagInfo[t].icon} />
                    {tagInfo[t].name}
                  </span>
                ))}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<script>
  const filter = document.querySelector<HTMLFieldSetElement>('[data-works-filter]');
  if (filter) {
    filter.hidden = false;
    const total = document.querySelector('[data-works-count]');
    filter.addEventListener('change', e => {
      const key = (e.target as HTMLInputElement).value;
      let shown = 0;
      document.querySelectorAll<HTMLElement>('[data-year]').forEach(section => {
        let n = 0;
        section.querySelectorAll<HTMLElement>('li[data-tags]').forEach(li => {
          const hit = key === 'all' || li.dataset.tags!.split(' ').includes(key);
          li.hidden = !hit;
          if (hit) n++;
        });
        section.hidden = n === 0;
        const c = section.querySelector('[data-year-count]');
        if (c) c.textContent = `${n} 点`;
        shown += n;
      });
      if (total) total.textContent = `${shown} 点`;
    });
  }
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    align-items: baseline;
    padding-block: 32px 20px;
  }
  h1 {
    font-size: clamp(2rem, 5.6vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .count {
    color: var(--color-muted);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    margin-left: auto;
    border: 0;
    padding: 0;
  }
  .filters[hidden] {
    display: none;
  }
  .filters label {
    cursor: pointer;
    color: var(--color-muted);
    font-size: 15px;
  }
  .filters input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .filters input:checked + span {
    color: var(--color-ink);
    border-bottom: 1px solid currentColor;
  }
  .filters input:focus-visible + span {
    outline: 2px solid var(--color-link);
    outline-offset: 3px;
  }

  .year h2 {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 1rem;
    font-weight: 600;
    border-bottom: 1px solid var(--color-ink);
    padding-top: 28px;
  }
  .year h2 small {
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 20px;
    padding-top: 18px;
  }
  .grid li[hidden] {
    display: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    line-height: 1.5;
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    background: var(--color-thumb);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .card:hover .thumb img {
    transform: scale(1.03);
  }
  .card b {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 4px;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .card:hover b {
    color: var(--color-link);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 10px;
    color: var(--color-muted);
    font-size: 12.5px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .tag :global(.line-icon) {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb img {
      transition: none;
    }
  }
</style>
