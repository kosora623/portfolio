---
import type { WorkFromMd } from '@/lib/work-model';
import { formatYearMonth } from '@/lib/work-model';
import { tagInfo } from '@/data/tags';
import LineIcon from '@/components/icons/LineIcon.astro';

interface Props {
  work: WorkFromMd;
  newer?: WorkFromMd;
  older?: WorkFromMd;
}

const { work, newer, older } = Astro.props;
const published = work.month ? `${work.year}年${work.month}月` : `${work.year}年`;
---

<article>
  <p class="crumb mono"><a href="/works" class="link">works</a>　/　{work.year}</p>
  <h1>{work.title}</h1>

  <div class="body">
    <div class="prose">
      <slot />
    </div>
    <dl class="meta">
      <div>
        <dt class="mono">発表</dt>
        <dd>{published}</dd>
      </div>
      <div>
        <dt class="mono">分野</dt>
        <dd class="tags">
          {
            work.tags.map(t => (
              <span>
                <LineIcon name={tagInfo[t]?.icon ?? 'code'} />
                {tagInfo[t]?.name ?? t}
              </span>
            ))
          }
        </dd>
      </div>
    </dl>
  </div>

  {
    (newer || older) && (
      <nav class="pn" aria-label="前後の作品">
        {newer ? (
          <a href={`/works/${newer.slug}`}>
            <small class="mono">← 新しいほう　{formatYearMonth(newer)}</small>
            <b>{newer.title}</b>
          </a>
        ) : (
          <span />
        )}
        {older && (
          <a href={`/works/${older.slug}`} class="older">
            <small class="mono">古いほう →　{formatYearMonth(older)}</small>
            <b>{older.title}</b>
          </a>
        )}
      </nav>
    )
  }
</article>

<style>
  .crumb {
    padding-top: 16px;
    color: var(--color-muted);
    font-size: 14px;
  }
  h1 {
    font-size: clamp(1.7rem, 4.8vw, 2.6rem);
    font-weight: 600;
    line-height: 1.45;
    padding-block: 10px 32px;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: start;
    border-top: 1px solid var(--color-line);
    padding-top: 36px;
  }
  .meta {
    border-top: 1px solid var(--color-ink);
    font-size: 14.5px;
    line-height: 1.7;
  }
  .meta div {
    border-bottom: 1px solid var(--color-line);
    padding-block: 12px;
  }
  .meta dt {
    color: var(--color-muted);
    font-size: 12.5px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .tags span {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    border-top: 1px solid var(--color-line);
    margin-top: 64px;
    padding-top: 22px;
    line-height: 1.6;
  }
  .pn small {
    display: block;
    color: var(--color-muted);
    font-size: 12.5px;
  }
  .pn b {
    font-weight: 500;
  }
  .pn a:hover b {
    color: var(--color-link);
  }
  .older {
    text-align: right;
  }

  @media (max-width: 760px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      border-top: 0;
      padding-top: 0;
    }
    .meta {
      order: -1;
    }
    .pn {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .older {
      text-align: left;
    }
  }
</style>
