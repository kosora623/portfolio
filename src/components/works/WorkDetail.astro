---
/** 作品の詳細ページ。ブログ記事と同じ組み方（中央の 1 列、題名の下に 1 行のメタ情報） */
import type { WorkFromMd } from '@/lib/work-model';
import { formatYearMonth } from '@/lib/work-model';
import { tagInfo } from '@/data/tags';
import LineIcon from '@/components/icons/LineIcon.astro';
import type { BlogPost } from '@/lib/blog-model';

interface Props {
  work: WorkFromMd;
  /** この作品について書いた記事（新しい順）。記事の frontmatter の works で指定する */
  posts?: BlogPost[];
  /** 1 つ新しい作品（ない場合は undefined） */
  newer?: WorkFromMd;
  /** 1 つ古い作品（ない場合は undefined） */
  older?: WorkFromMd;
}

const { work, posts = [], newer, older } = Astro.props;
const published = work.month ? `${work.year}-${String(work.month).padStart(2, '0')}` : String(work.year);
---

<article>
  <p class="crumb mono"><a href="/works" class="link">works</a></p>
  <h1>{work.title}</h1>
  <p class="meta mono">
    <time datetime={published}>{formatYearMonth(work)}</time>
    {
      work.tags.map(t => (
        <span class="tag">
          <LineIcon name={tagInfo[t]?.icon ?? 'code'} />
          {tagInfo[t]?.name ?? t}
        </span>
      ))
    }
  </p>

  <div class="prose body">
    <slot />
  </div>

  <footer class="work-end">
    {
      posts.length > 0 && (
        <ul class="posts" aria-label="この作品について書いた記事">
          {posts.map(post => (
            <li>
              <a href={`/blog/${post.slug}`}>
                <span class="mono">記事</span>
                <b>{post.title}</b>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      (older || newer) && (
        <nav class="work-nav" aria-label="ほかの作品">
          {older && (
            <a href={`/works/${older.slug}`} class="older">
              <span class="mono">← 前の作品</span>
              <b>{older.title}</b>
            </a>
          )}
          {newer && (
            <a href={`/works/${newer.slug}`} class="newer">
              <span class="mono">次の作品 →</span>
              <b>{newer.title}</b>
            </a>
          )}
        </nav>
      )
    }
    <p class="back mono"><a href="/works" class="link">作品一覧へ</a></p>
  </footer>
</article>

<style>
  /* 本文の幅（.prose と同じ 36em）の列をページの中央に置く。ブログ記事と同じ */
  article {
    max-width: 36em;
    margin-inline: auto;
  }
  .crumb {
    padding-top: 16px;
    color: var(--color-muted);
    font-size: 14px;
  }
  h1 {
    font-size: clamp(1.7rem, 4.8vw, 2.6rem);
    font-weight: 600;
    line-height: 1.45;
    padding-block: 10px 6px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 14px;
    color: var(--color-muted);
    font-size: 13.5px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .tag :global(.line-icon) {
    width: 15px;
    height: 15px;
  }
  .body {
    border-top: 1px solid var(--color-line);
    margin-top: 24px;
    padding-top: 36px;
  }
  .work-end {
    margin-top: 56px;
    border-top: 1px solid var(--color-line);
  }
  .posts a,
  .work-nav a {
    display: block;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-line);
    line-height: 1.6;
  }
  .posts span,
  .work-nav span {
    display: block;
    color: var(--color-muted);
    font-size: 13px;
  }
  .posts b,
  .work-nav b {
    font-weight: 500;
  }
  .posts a:hover b,
  .work-nav a:hover b {
    color: var(--color-link);
  }
  .work-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
  }
  .work-nav .newer {
    grid-column: 2;
    text-align: right;
  }
  .back {
    padding-top: 20px;
    font-size: 14px;
  }
  @media (max-width: 520px) {
    .work-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .work-nav .newer {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
