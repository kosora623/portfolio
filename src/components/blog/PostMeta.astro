---
import { formatDate, tagHref, type BlogPost } from '@/lib/blog-model';

interface Props {
  post: BlogPost;
  /** タグをタグ別の一覧（/blog/tags/<タグ>）へのリンクにする。一覧の中（全体がリンク）では false のまま */
  linkTags?: boolean;
}

const { post, linkTags = false } = Astro.props;
---

<span class="post-meta mono">
  <time datetime={formatDate(post.date)}>{formatDate(post.date).replaceAll('-', '.')}</time>
  {
    post.tags.map(tag =>
      linkTags ? <a href={tagHref(tag)} class="tag">#{tag}</a> : <span>#{tag}</span>,
    )
  }
  {post.draft && <span class="draft">下書き</span>}
</span>

<style>
  .post-meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    color: var(--color-muted);
    font-size: 13.5px;
  }
  .tag:hover {
    color: var(--color-link);
  }
  .draft {
    color: var(--color-ink);
    border: 1px solid currentColor;
    padding: 0 6px;
  }
</style>
