---
import { formatDate, type BlogPost } from '@/lib/blog-model';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<span class="post-meta mono">
  <time datetime={formatDate(post.date)}>{formatDate(post.date).replaceAll('-', '.')}</time>
  {post.tags.map(tag => <span>#{tag}</span>)}
  {post.draft && <span class="draft">下書き</span>}
</span>

<style>
  .post-meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    color: var(--color-muted);
    font-size: 13.5px;
  }
  .draft {
    color: var(--color-ink);
    border: 1px solid currentColor;
    padding: 0 6px;
  }
</style>
