---
/** ブログ記事の一覧（作品一覧と同じ組み方） */
import type { BlogPost } from '@/lib/blog-model';
import PostMeta from './PostMeta.astro';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="head">
  <h1>Blog</h1>
  <span class="mono count">{posts.length} 件</span>
  <a href="/rss.xml" class="mono rss">RSS</a>
</div>

{
  posts.length === 0 ? (
    <p class="empty">まだ記事はありません。</p>
  ) : (
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.slug}`} class="item">
            <b>{post.title}</b>
            {post.description && <small>{post.description}</small>}
            <PostMeta post={post} />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .head {
    display: flex;
    gap: 8px 28px;
    align-items: baseline;
    padding-block: 32px 20px;
    border-bottom: 1px solid var(--color-ink);
  }
  h1 {
    font-size: clamp(2rem, 5.6vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .rss {
    margin-left: auto;
    font-size: 13.5px;
    color: var(--color-muted);
  }
  .rss:hover {
    color: var(--color-link);
  }
  .count,
  .empty {
    color: var(--color-muted);
  }
  .empty {
    padding-top: 24px;
  }
  .item {
    display: block;
    border-bottom: 1px solid var(--color-line);
    padding-block: 18px;
    line-height: 1.6;
  }
  .item b {
    display: block;
    font-weight: 500;
    font-size: 1.1rem;
  }
  .item small {
    display: block;
    color: var(--color-muted);
    font-size: 14px;
    margin-block: 4px 6px;
  }
  .item:hover b {
    color: var(--color-link);
  }
</style>
