---
/** ブログ記事の一覧（作品一覧と同じ組み方） */
import { tagHref, type BlogPost } from '@/lib/blog-model';
import PostMeta from './PostMeta.astro';

interface Props {
  posts: BlogPost[];
  /** 見出し（タグ別の一覧では「#タグ」） */
  heading?: string;
  /** 見出しの下に並べるタグ（ブログのトップだけ） */
  tags?: { tag: string; count: number }[];
  /** 今表示しているタグ（タグ別の一覧のとき） */
  currentTag?: string;
}

const { posts, heading = 'Blog', tags = [], currentTag } = Astro.props;
---

{currentTag && <p class="crumb mono"><a href="/blog" class="link">blog</a></p>}
<div class="head">
  <h1>{heading}</h1>
  <a href="/rss.xml" class="mono rss">RSS</a>
</div>
{
  tags.length > 0 && (
    <ul class="tags mono" aria-label="タグ">
      {tags.map(({ tag }) => (
        <li>
          <a href={tagHref(tag)}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}

{
  posts.length === 0 ? (
    <p class="empty">まだ記事はありません。</p>
  ) : (
    <ul class="list">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.slug}`} class="item">
            <b>{post.title}</b>
            {post.description && <small>{post.description}</small>}
            <PostMeta post={post} />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .crumb {
    padding-top: 16px;
    margin-bottom: -16px;
    color: var(--color-muted);
    font-size: 14px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: -8px;
    padding-bottom: 20px;
    font-size: 13.5px;
  }
  .tags a {
    color: var(--color-muted);
  }
  .tags a:hover {
    color: var(--color-link);
  }
  .head {
    display: flex;
    gap: 8px 28px;
    align-items: baseline;
    padding-block: 32px 20px;
  }
  h1 {
    font-size: clamp(2rem, 5.6vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
  }
  .rss {
    margin-left: auto;
    font-size: 13.5px;
    color: var(--color-muted);
  }
  .rss:hover {
    color: var(--color-link);
  }
  .empty {
    color: var(--color-muted);
  }
  .empty {
    padding-top: 24px;
  }
  /* 作品一覧と同じく、見出しの下に薄い線を 1 本だけ引く（記事ごとの線は引かない） */
  .list {
    border-top: 1px solid var(--color-line);
    padding-top: 8px;
  }
  .item {
    display: block;
    padding-block: 18px;
    line-height: 1.6;
  }
  .item b {
    display: block;
    font-weight: 500;
    font-size: 1.1rem;
  }
  .item small {
    display: block;
    color: var(--color-muted);
    font-size: 14px;
    margin-block: 4px 6px;
  }
  .item:hover b {
    color: var(--color-link);
  }
</style>
