---
/** ブログ記事ページ（作品詳細と同じ組み方） */
import type { BlogPost } from '@/lib/blog-model';
import type { WorkFromMd } from '@/lib/work-model';
import PostMeta from './PostMeta.astro';

interface Props {
  post: BlogPost;
  /** この記事で取り上げた作品 */
  works?: WorkFromMd[];
  /** 1 つ新しい記事（ない場合は undefined） */
  newer?: BlogPost;
  /** 1 つ古い記事（ない場合は undefined） */
  older?: BlogPost;
}

const { post, works = [], newer, older } = Astro.props;
---

<article>
  <p class="crumb mono"><a href="/blog" class="link">blog</a></p>
  <h1>{post.title}</h1>
  <PostMeta post={post} linkTags />
  <div class="prose body">
    <slot />
  </div>
  <footer class="post-end">
    {
      works.length > 0 && (
        <ul class="works" aria-label="この記事の作品">
          {works.map(work => (
            <li>
              <a href={`/works/${work.slug}`}>
                <span class="mono">作品</span>
                <b>{work.title}</b>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      (older || newer) && (
        <nav class="post-nav" aria-label="ほかの記事">
          {older && (
            <a href={`/blog/${older.slug}`} class="older">
              <span class="mono">← 前の記事</span>
              <b>{older.title}</b>
            </a>
          )}
          {newer && (
            <a href={`/blog/${newer.slug}`} class="newer">
              <span class="mono">次の記事 →</span>
              <b>{newer.title}</b>
            </a>
          )}
        </nav>
      )
    }
    <p class="back mono"><a href="/blog" class="link">記事一覧へ</a></p>
  </footer>
</article>

<style>
  /* 本文の幅（.prose と同じ 36em）の列をページの中央に置く。広い画面で右だけが空かないように */
  article {
    max-width: 36em;
    margin-inline: auto;
  }
  .crumb {
    padding-top: 16px;
    color: var(--color-muted);
    font-size: 14px;
  }
  h1 {
    font-size: clamp(1.7rem, 4.8vw, 2.6rem);
    font-weight: 600;
    line-height: 1.45;
    padding-block: 10px 6px;
  }
  .body {
    border-top: 1px solid var(--color-line);
    margin-top: 24px;
    padding-top: 36px;
  }
  .post-end {
    max-width: 36em;
    margin-top: 56px;
    border-top: 1px solid var(--color-line);
  }
  .works a {
    display: block;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-line);
    line-height: 1.6;
  }
  .works span {
    display: block;
    color: var(--color-muted);
    font-size: 13px;
  }
  .works b {
    font-weight: 500;
  }
  .works a:hover b {
    color: var(--color-link);
  }
  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
  }
  .post-nav a {
    display: block;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-line);
    line-height: 1.6;
  }
  .post-nav .newer {
    grid-column: 2;
    text-align: right;
  }
  .post-nav span {
    display: block;
    color: var(--color-muted);
    font-size: 13px;
  }
  .post-nav b {
    font-weight: 500;
  }
  .post-nav a:hover b {
    color: var(--color-link);
  }
  .back {
    padding-top: 20px;
    font-size: 14px;
  }
  @media (max-width: 520px) {
    .post-nav {
      grid-template-columns: minmax(0, 1fr);
    }
    .post-nav .newer {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
