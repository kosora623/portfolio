---
/** ブログ記事ページ（作品詳細と同じ組み方） */
import type { BlogPost } from '@/lib/blog-model';
import PostMeta from './PostMeta.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article>
  <p class="crumb mono"><a href="/blog" class="link">blog</a></p>
  <h1>{post.title}</h1>
  <PostMeta post={post} />
  <div class="prose body">
    <slot />
  </div>
</article>

<style>
  .crumb {
    padding-top: 16px;
    color: var(--color-muted);
    font-size: 14px;
  }
  h1 {
    font-size: clamp(1.7rem, 4.8vw, 2.6rem);
    font-weight: 600;
    line-height: 1.45;
    padding-block: 10px 6px;
  }
  .body {
    border-top: 1px solid var(--color-line);
    margin-top: 24px;
    padding-top: 36px;
  }
</style>
