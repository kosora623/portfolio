---
import { navItems, site } from '@/data/site';

/** 現在のページ（/works/foo なら Works） */
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<a href="#main" class="skip sr-only-focusable">本文へ移動</a>
<header class="page site-header">
  <a href="/" class="logo" aria-label={`${site.shortName}（ホーム）`}><span class="logo-mark" aria-hidden="true"></span>{site.shortName}</a>
  <nav aria-label="メイン">
    <ul>
      {
        navItems.map(item => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: 8px;
    z-index: 10;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 4px 12px;
  }
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 24px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 17px;
    line-height: 1.6;
  }
  .logo-mark {
    width: 14px;
    height: 14px;
    background: linear-gradient(var(--sky-top), var(--sky-bottom));
  }
  ul {
    display: flex;
    gap: 22px;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--color-muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  nav a[aria-current='page'] {
    border-bottom: 1px solid currentColor;
  }
</style>
