---
import { navItems, site } from '@/data/site';
---

<header class="fixed top-0 left-0 w-full z-50 pointer-events-auto transition-all duration-300 bg-transparent" role="banner">
  <nav class="container mx-auto p-4 flex justify-between items-center">
    <a href="/" class="text-2xl font-bold text-teal tracking-wider z-50 pointer-events-auto">{site.shortName}</a>
    <div class="space-x-6 flex items-center">
      {
        navItems.map(item => (
          <a
            href={item.href}
            class="text-light-slate transition-all duration-200 transform hover:text-teal hover:scale-105 hover:translate-y-[-2px] z-50 pointer-events-auto"
          >
            <span class="relative after:absolute after:inset-x-0 after:-bottom-1 after:h-[2px] after:bg-transparent hover:after:bg-teal after:transition-all after:duration-200">{item.name}</span>
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  // 10px 以上スクロールしたら背景を付ける（React 版と同じく、最初のスクロールで判定する）
  const header = document.querySelector<HTMLElement>('header[role="banner"]');
  const scrolledClasses = ['bg-navy/80', 'backdrop-blur-sm', 'shadow-lg'];
  let scrolled = false;
  window.addEventListener('scroll', () => {
    const next = window.scrollY > 10;
    if (!header || next === scrolled) return;
    scrolled = next;
    if (next) {
      header.classList.remove('bg-transparent');
      header.classList.add(...scrolledClasses);
    } else {
      header.classList.remove(...scrolledClasses);
      header.classList.add('bg-transparent');
    }
  });
</script>
