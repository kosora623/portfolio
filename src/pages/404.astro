---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---

<BaseLayout title={`ページが見つかりません | ${site.shortName}`} robots="noindex">
  <section class="not-found">
    <p class="label">404</p>
    <h1>ページが見つかりません</h1>
    <p>URL が変わったか、ページが削除された可能性があります。</p>
    <p class="links"><a class="button" href="/">ホームへ</a><a class="button" href="/works">Works へ</a></p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 64px 32px;
  }
  h1 {
    font-size: clamp(1.7rem, 4.8vw, 2.6rem);
    font-weight: 600;
    line-height: 1.45;
    margin-bottom: 8px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
