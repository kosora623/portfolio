---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AsciiComment from '@/components/AsciiComment.astro';
import MaintenancePage from '@/components/MaintenancePage.astro';
import Seo from '@/components/Seo.astro';
import type { PageMeta } from '@/lib/seo';
import { MAINTENANCE_MODE } from '@/lib/maintenance';
import { site } from '@/data/site';

interface Props {
  /** <title> をそのまま指定する（404 など、OGP が不要なページ用） */
  title?: string;
  robots?: string;
  /** <title> / description / OGP（works・blog 共通の仕組み） */
  meta?: PageMeta;
}

const { title, robots, meta } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      MAINTENANCE_MODE ? (
        <>
          {robots && <meta name="robots" content={robots} />}
          <title>サイト改修中 | {site.title}</title>
          <meta name="robots" content="noindex, nofollow" />
        </>
      ) : (
        <>
          {meta ? <Seo meta={meta} /> : title && <title>{title}</title>}
          {robots && <meta name="robots" content={robots} />}
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!MAINTENANCE_MODE && <link rel="alternate" type="application/rss+xml" title={`${site.title}のブログ`} href="/rss.xml" />}
    <meta name="theme-color" content="#f5f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131a26" media="(prefers-color-scheme: dark)" />
    <!--
      見ている人の時刻に合わせて空の色を変える（JS が動かない環境では昼の色）。
      ヘッダーのボタンでライト/ダークを選んでいれば、描画の前に反映する（ちらつかないよう head で行う）。
    -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const h = new Date().getHours();
        root.dataset.sky = h >= 5 && h < 8 ? 'morning' : h >= 8 && h < 16 ? 'day' : h >= 16 && h < 19 ? 'evening' : 'night';
        root.dataset.js = '';
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme === 'light' || theme === 'dark') {
          root.dataset.theme = theme;
          const color = theme === 'dark' ? '#131a26' : '#f5f7f9';
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.content = color; });
        }
      })();
    </script>
    {!MAINTENANCE_MODE && <AsciiComment />}
  </head>
  {
    MAINTENANCE_MODE ? (
      <body>
        <MaintenancePage />
      </body>
    ) : (
      <body class="layout">
        <Header />
        <main id="main" class="page" tabindex="-1">
          <slot />
        </main>
        <Footer />
      </body>
    )
  }
</html>
